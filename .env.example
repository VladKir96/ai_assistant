# First-time setup: docs/startup.md. Run commands from the project directory.
# Run `uv run assistant init` once to generate private random credentials in .env.
# Keep an existing .env; the PostgreSQL volume retains its original password.
ASSISTANT_API_TOKEN=change-me
ASSISTANT_POSTGRES_PASSWORD=change-me
ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:change-me@localhost:5432/assistant
ASSISTANT_REDIS_URL=redis://localhost:6379/0
ASSISTANT_API_URL=http://localhost:8000

ASSISTANT_MODEL_PROVIDER=local
# Switch model settings together with `uv run assistant models --use NAME`.
# Named, non-secret presets are in model-profiles.toml.
ASSISTANT_LOCAL_BASE_URL=http://localhost:8080/v1
ASSISTANT_LOCAL_MODEL=Qwen3.8-27B-Q4_K_M
ASSISTANT_LOCAL_MODEL_FILE=
# Enable only for a model that accepts images. Local llama.cpp also needs its matching mmproj.
ASSISTANT_MODEL_SUPPORTS_IMAGES=false
ASSISTANT_LOCAL_MMPROJ_FILE=
# Reserved image tokens for the visual observation call; not an exact image-token count.
ASSISTANT_VISION_TOKEN_RESERVE=4096
ASSISTANT_LOCAL_API_KEY=
ASSISTANT_LLAMA_EXECUTABLE=llama-server
ASSISTANT_OPENAI_API_KEY=
# Explicitly choose a cloud model before selecting provider=openai.
ASSISTANT_OPENAI_MODEL=
ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_CONTEXT_WINDOW=16384
ASSISTANT_MAX_OUTPUT_TOKENS=2048
ASSISTANT_REQUEST_TIMEOUT_SECONDS=180
ASSISTANT_ENABLE_THINKING=false
# Supervisor re-planning rounds after rejected review; 0 disables, maximum 5.
ASSISTANT_MAX_REVIEW_REPLANS=2
# The supervisor may assign up to five agent tasks with five tools total per round.
# Limit concurrently active specialists (1..5); 1 executes team branches sequentially.
ASSISTANT_MAX_PARALLEL_AGENTS=3
# Simultaneous inference calls (1..8). Keep 1 for the default single-slot local llama.cpp.
# Independent agents can overlap network/tools even while model calls are serialized.
ASSISTANT_MODEL_MAX_CONCURRENCY=1

# Optional calculations/charts in disposable Docker sandboxes. See docs/python-analysis.md.
ASSISTANT_PYTHON_ENABLED=false
ASSISTANT_PYTHON_RUNNER_URL=http://localhost:8766
# Optional independent runner credential; blank derives a scoped token from API_TOKEN.
ASSISTANT_PYTHON_RUNNER_TOKEN=
ASSISTANT_PYTHON_WORKER_IMAGE=personal-assistant-python:local
ASSISTANT_ARTIFACT_DIRECTORY=data/artifacts

# Optional Langfuse tracing: create a project in Langfuse Cloud or your own deployment.
# Use project API keys, not an LLM-provider key. See docs/observability.md.
ASSISTANT_LANGFUSE_ENABLED=false
ASSISTANT_LANGFUSE_PUBLIC_KEY=
ASSISTANT_LANGFUSE_SECRET_KEY=
ASSISTANT_LANGFUSE_BASE_URL=https://cloud.langfuse.com
ASSISTANT_LANGFUSE_ENVIRONMENT=development
# Fraction of requests to trace (0..1); children follow the same sampling decision.
ASSISTANT_LANGFUSE_SAMPLE_RATE=1.0
# Default: timings, outcomes, model/token usage only. Opt in to bounded private text.
ASSISTANT_LANGFUSE_CAPTURE_CONTENT=false

# Telegram: paste the COMPLETE BotFather token (numeric prefix:secret suffix).
# The token's numeric prefix is the BOT ID, not your personal owner ID.
ASSISTANT_TELEGRAM_TOKEN=
# For setup, leave 0, run `uv run assistant bot`, send /id in its private chat.
# Save the returned personal ID here, then stop/restart the bot to apply it.
# Only /id is available before owner setup; assistant commands stay restricted.
ASSISTANT_TELEGRAM_OWNER_ID=0
# IANA timezone for relative dates, local note-date filters, and the default event timezone.
# Restart the API after changing this value. Timestamps are stored in UTC.
ASSISTANT_TIMEZONE=Europe/Belgrade

# disabled = keyword search only; http = local BGE service or compatible endpoint.
ASSISTANT_EMBEDDING_BACKEND=disabled
ASSISTANT_EMBEDDING_BASE_URL=http://localhost:8081/v1
ASSISTANT_EMBEDDING_API_KEY=
ASSISTANT_EMBEDDING_MODEL=BAAI/bge-m3
ASSISTANT_EMBEDDING_DIMENSIONS=1024
ASSISTANT_EMBEDDING_DEVICE=cpu
# DuckDuckGo uses the third-party ddgs library; no account/API key needed.
# Options: duckduckgo, tavily (requires its key below), disabled.
ASSISTANT_SEARCH_PROVIDER=duckduckgo
# Worldwide search; optionally use us-en or ru-ru for a regional preference.
ASSISTANT_DUCKDUCKGO_REGION=wt-wt
ASSISTANT_TAVILY_API_KEY=
# General research can read public URLs. Career searches require these sources.
ASSISTANT_JOB_SITES=[]

# Structured weather uses the free non-commercial Open-Meteo API, independently of search.
# Leave coordinates empty to ask for a location; configure both to set a default.
ASSISTANT_WEATHER_ENABLED=true
ASSISTANT_WEATHER_DEFAULT_NAME=
ASSISTANT_WEATHER_DEFAULT_LATITUDE=
ASSISTANT_WEATHER_DEFAULT_LONGITUDE=

# STT backend: whisper_cpp (existing executable) or faster_whisper (speech extra).
ASSISTANT_STT_BACKEND=whisper_cpp
ASSISTANT_FASTER_WHISPER_MODEL=models/faster-whisper-large-v3
# Mac: cpu + int8. CUDA is for compatible NVIDIA hosts; Apple Metal/MPS is unsupported.
ASSISTANT_FASTER_WHISPER_DEVICE=cpu
ASSISTANT_FASTER_WHISPER_COMPUTE_TYPE=int8
ASSISTANT_FASTER_WHISPER_CPU_THREADS=8
ASSISTANT_STT_LANGUAGE=auto
# Optional executables: faster_whisper input needs neither whisper-cli nor FFmpeg.
ASSISTANT_WHISPER_EXECUTABLE=whisper-cli
ASSISTANT_WHISPER_MODEL=
ASSISTANT_PIPER_EXECUTABLE=piper
ASSISTANT_PIPER_EN_MODEL=
ASSISTANT_PIPER_RU_MODEL=
ASSISTANT_FFMPEG_EXECUTABLE=ffmpeg
ASSISTANT_VOICE_ENABLED=false
# Set false for voice input + text replies; true additionally requires Piper/FFmpeg for TTS.
ASSISTANT_VOICE_OUTPUT_ENABLED=true
ASSISTANT_SPEECH_TIMEOUT_SECONDS=600
ASSISTANT_SPEECH_BASE_URL=http://localhost:8765

# Optional MCP tools are read-only and must be explicitly allowed by name.
ASSISTANT_MCP_SERVERS_FILE=

# Managed read-only mcp-pdf-reader integration: install --extra pdf and mkdir -p data/pdf.
ASSISTANT_PDF_ENABLED=false
ASSISTANT_PDF_DIRECTORY=data/pdf
# Telegram/API uploads are stored separately; the MCP reader addresses them as uploads/<hash>.pdf.
ASSISTANT_PDF_UPLOAD_DIRECTORY=data/pdf-uploads
# Optional OCR: folder containing eng.traineddata and rus.traineddata (no auto-download).
ASSISTANT_PDF_TESSDATA_DIRECTORY=

