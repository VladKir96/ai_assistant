# Personal Assistant configuration
# Daily startup: uv run assistant start
# All feature Python dependencies are included. Use the switches below to select services.
# Model weights, Docker, llama-server, and native FFmpeg need the setup described below.
# First-time setup: docs/startup.md (native) or docs/docker.md (containers).
# Edit this file in a text editor; do not source it into your shell.
# Exported ASSISTANT_* shell variables override this file. Restart affected services after edits.
# Never share or commit .env; its generated credentials are private.

# ============================================================================
# 1. Feature switches
# ============================================================================
# All feature libraries are installed by `uv sync`; no --extra flags are needed.
# These switches choose behavior at runtime. Disabled services are not started.
# Models and external executables must still be configured in the sections below.
# Telegram uses its token/owner settings; use `assistant start --no-bot` to omit it.
# Reminder workers/Redis are started separately; see README.md#reminders.
# Accept incoming voice messages. Configure speech recognition in section 6.
ASSISTANT_VOICE_ENABLED=false
# Enable spoken replies. Configure Piper voices and FFmpeg in sections 7-8; then /audio on.
ASSISTANT_VOICE_OUTPUT_ENABLED=false
# Read/upload PDFs through the managed reader. Configure directories in section 9.
ASSISTANT_PDF_ENABLED=false
# Accept images only with a capable model; local models also need their matching projector.
ASSISTANT_MODEL_SUPPORTS_IMAGES=false
# disabled = keyword retrieval; http = start the local embedding companion (section 10).
ASSISTANT_EMBEDDING_BACKEND=disabled
# Run calculations/charts in Docker sandboxes (section 11).
ASSISTANT_PYTHON_ENABLED=false
# Send execution traces to your configured Langfuse deployment (section 14).
ASSISTANT_LANGFUSE_ENABLED=false
# duckduckgo = no key; tavily = key required in section 12; disabled = no web search.
ASSISTANT_SEARCH_PROVIDER=duckduckgo
# Enable structured Open-Meteo weather, independently of the web search setting.
ASSISTANT_WEATHER_ENABLED=true

# ============================================================================
# 2. Private credentials, Telegram, and local endpoints
# ============================================================================
# Generate random credentials once with `uv run assistant init`; never overwrite an existing .env.
# Compose overrides host endpoints with container service names; see docs/docker.md.
# Native `assistant start` expects the assistant database/user on localhost:5432.
# Private bearer token for API and companion services; generated by assistant init.
ASSISTANT_API_TOKEN=change-me
# Must match the password retained by your PostgreSQL volume.
ASSISTANT_POSTGRES_PASSWORD=change-me
# Use the same password as POSTGRES_PASSWORD; do not regenerate it for an existing database.
ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:change-me@localhost:5432/assistant
# Redis is used by the separately started reminder worker/scheduler.
ASSISTANT_REDIS_URL=redis://localhost:6379/0
# URL used by the CLI and Telegram bot to reach the API.
ASSISTANT_API_URL=http://localhost:8000
# Complete BotFather token: numeric bot ID, colon, secret suffix. Keep private.
ASSISTANT_TELEGRAM_TOKEN=
# Your personal numeric user ID, not the bot ID. Leave 0, run assistant bot, send /id, then save it.
ASSISTANT_TELEGRAM_OWNER_ID=0
# IANA timezone for today/tomorrow, note filters, and calendar defaults; stored timestamps remain UTC.
ASSISTANT_TIMEZONE=Europe/Belgrade

# ============================================================================
# 3. Chat model and request budgets
# ============================================================================
# local uses llama.cpp (section 4); openai uses the configured Responses API provider (section 5).
# Select named presets with `uv run assistant models --use NAME`; see model-profiles.toml.
# Profile selection updates model/image settings only. Restart the API/model after switching.
ASSISTANT_MODEL_PROVIDER=local
# Model-supported context size. Must leave room for input, output, and template overhead.
ASSISTANT_CONTEXT_WINDOW=16384
ASSISTANT_MAX_OUTPUT_TOKENS=2048
# Per-model-request timeout; CPU inference may need more time.
ASSISTANT_REQUEST_TIMEOUT_SECONDS=180
ASSISTANT_ENABLE_THINKING=false
# Retries after rejected review: 0..5; 0 disables repair rounds.
ASSISTANT_MAX_REVIEW_REPLANS=2
# Active specialists: 1..5; independent tool/network work may overlap.
ASSISTANT_MAX_PARALLEL_AGENTS=3
# Concurrent model calls: 1..8. Keep 1 for the default single-slot llama.cpp server.
ASSISTANT_MODEL_MAX_CONCURRENCY=1

# ============================================================================
# 4. Local inference and vision
# ============================================================================
# Used when MODEL_PROVIDER=local. Download model weights separately; startup does not download them.
# Paths are relative to the project directory unless absolute. Docker mounts the host GGUF separately.
# For image understanding, set MODEL_SUPPORTS_IMAGES=true and use the exact matching mmproj export.
ASSISTANT_LOCAL_BASE_URL=http://localhost:8080/v1
# Server model alias; must match the alias configured for your inference server.
ASSISTANT_LOCAL_MODEL=Qwen3.8-27B-Q4_K_M
# Existing chat GGUF file. Required for native startup and containerized local inference.
ASSISTANT_LOCAL_MODEL_FILE=
# Private inference key, generated by assistant init.
ASSISTANT_LOCAL_API_KEY=
# llama-server on PATH, or its absolute executable path; not installed by uv.
ASSISTANT_LLAMA_EXECUTABLE=llama-server
# Matching projector GGUF; leave empty for text-only operation. See docs/images.md.
ASSISTANT_LOCAL_MMPROJ_FILE=
# Reserved image input allowance, not an exact image-token count.
ASSISTANT_VISION_TOKEN_RESERVE=4096

# ============================================================================
# 5. Hosted inference
# ============================================================================
# Used only when MODEL_PROVIDER=openai. Set an explicit model supporting Responses and JSON schema.
# There is no automatic local-to-hosted fallback. The provider receives selected request context.
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_OPENAI_MODEL=
ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# 6. Voice input: speech recognition
# ============================================================================
# Used when VOICE_ENABLED=true. Speech support is included; choose your configured backend.
# faster_whisper uses a complete CTranslate2 directory; download with `uv run assistant speech-download`.
# whisper_cpp instead uses an externally installed whisper-cli and a whisper.cpp model; it needs FFmpeg.
# Options: faster_whisper or whisper_cpp. Their model formats are not interchangeable.
ASSISTANT_STT_BACKEND=whisper_cpp
# CTranslate2 directory containing model.bin, config/tokenizer/preprocessor files, and vocabulary.
ASSISTANT_FASTER_WHISPER_MODEL=models/faster-whisper-large-v3
# cpu or cuda. On Apple Silicon use cpu; CTranslate2 does not use Metal/MPS.
ASSISTANT_FASTER_WHISPER_DEVICE=cpu
# int8 is the portable CPU choice; select a supported type for your device.
ASSISTANT_FASTER_WHISPER_COMPUTE_TYPE=int8
ASSISTANT_FASTER_WHISPER_CPU_THREADS=8
# auto, en, ru, or sr.
ASSISTANT_STT_LANGUAGE=auto
# Only for whisper_cpp; ignored by faster_whisper.
ASSISTANT_WHISPER_EXECUTABLE=whisper-cli
# Only for whisper_cpp: path to its .bin model, not a chat GGUF or CTranslate2 directory.
ASSISTANT_WHISPER_MODEL=

# ============================================================================
# 7. Voice output: Piper
# ============================================================================
# Used when VOICE_OUTPUT_ENABLED=true; independent of voice input.
# Piper and automatic language detection are included. Download voice weights separately (docs/voice.md).
# Each configured .onnx voice needs its matching .onnx.json beside it. Leave unused languages empty.
# Telegram /audio on enables spoken replies for your chat; /audio off returns to text-only.
# Bundled piper executable on the uv environment PATH, or an explicit custom path.
ASSISTANT_PIPER_EXECUTABLE=piper
ASSISTANT_PIPER_EN_MODEL=
ASSISTANT_PIPER_RU_MODEL=
ASSISTANT_PIPER_SR_MODEL=

# ============================================================================
# 8. Shared speech service and FFmpeg
# ============================================================================
# The launcher starts one speech companion if voice input or output is enabled.
# FFmpeg is required for Piper replies and whisper_cpp input; faster_whisper input alone does not need it.
# Install FFmpeg separately on the host (Mac: brew install ffmpeg; Linux: your package manager).
# The application Docker image includes FFmpeg. An explicit executable path overrides PATH lookup.
ASSISTANT_FFMPEG_EXECUTABLE=ffmpeg
ASSISTANT_SPEECH_BASE_URL=http://localhost:8765
# Speech request timeout, in seconds.
ASSISTANT_SPEECH_TIMEOUT_SECONDS=600

# ============================================================================
# 9. PDF reading and uploads
# ============================================================================
# Used when PDF_ENABLED=true. The PDF/MCP libraries are included; no PDF startup extra is needed.
# Create the reference directory first: mkdir -p data/pdf. See docs/pdf.md for extraction limits.
# Docker uses read-only reference/OCR mounts and a writable named volume for uploads.
# Reference PDFs. The managed reader never writes extracted text into this directory.
ASSISTANT_PDF_DIRECTORY=data/pdf
# Private retained Telegram/API uploads; stored separately from reference PDFs.
ASSISTANT_PDF_UPLOAD_DIRECTORY=data/pdf-uploads
# Optional OCR language-data folder (eng.traineddata and rus.traineddata). Empty means OCR unconfigured.
ASSISTANT_PDF_TESSDATA_DIRECTORY=

# ============================================================================
# 10. Semantic retrieval: embedding companion
# ============================================================================
# Used when EMBEDDING_BACKEND=http. The launcher starts this companion automatically.
# First use may download the embedding model into data/models/embeddings.
# Keep the API key equal to API_TOKEN for the built-in service (assistant init does this).
# Default Linux dependencies use CPU PyTorch; Apple MPS is available with the macOS build.
# Changing embedding models requires `uv run assistant reindex`. Keyword search works when disabled.
ASSISTANT_EMBEDDING_BASE_URL=http://localhost:8081/v1
ASSISTANT_EMBEDDING_API_KEY=
ASSISTANT_EMBEDDING_MODEL=BAAI/bge-m3
# The database schema expects 1024 dimensions.
ASSISTANT_EMBEDDING_DIMENSIONS=1024
# cpu is portable; mps is for compatible Apple hardware. Other accelerators need a matching runtime build.
ASSISTANT_EMBEDDING_DEVICE=cpu

# ============================================================================
# 11. Python calculations and charts
# ============================================================================
# Used when PYTHON_ENABLED=true. The launcher builds the worker image and starts the private broker.
# Docker must be running. Generated code executes only in isolated containers, never on the host.
# See docs/python-analysis.md for the separate Docker deployment profile and execution limits.
ASSISTANT_PYTHON_RUNNER_URL=http://localhost:8766
# Optional independent private token; empty derives a scoped credential from API_TOKEN.
ASSISTANT_PYTHON_RUNNER_TOKEN=
ASSISTANT_PYTHON_WORKER_IMAGE=personal-assistant-python:local
# Private generated PNG charts.
ASSISTANT_ARTIFACT_DIRECTORY=data/artifacts

# ============================================================================
# 12. Web search, career sources, and other MCP tools
# ============================================================================
# SEARCH_PROVIDER is selected in section 1. Public HTML/text URL reading works without a search key.
# Other MCP servers are explicitly configured read-only integrations; the managed PDF server is automatic.
# wt-wt = worldwide; us-en and ru-ru are regional alternatives.
ASSISTANT_DUCKDUCKGO_REGION=wt-wt
# Only required for SEARCH_PROVIDER=tavily.
ASSISTANT_TAVILY_API_KEY=
# JSON array of permitted career-search hostnames, for example ["jobs.example.org"].
ASSISTANT_JOB_SITES=[]
# Optional trusted MCP server configuration JSON; empty means no custom servers.
ASSISTANT_MCP_SERVERS_FILE=

# ============================================================================
# 13. Default weather location
# ============================================================================
# Used when WEATHER_ENABLED=true. Open-Meteo is independent of the search provider.
# Set both coordinates together, or leave both empty and ask for a location per request.
# Timezone alone does not establish the user's location.
ASSISTANT_WEATHER_DEFAULT_NAME=
ASSISTANT_WEATHER_DEFAULT_LATITUDE=
ASSISTANT_WEATHER_DEFAULT_LONGITUDE=

# ============================================================================
# 14. Langfuse tracing
# ============================================================================
# Used when LANGFUSE_ENABLED=true. Needs your own project/server and its separate project keys.
# No Langfuse server is bundled. Content capture is off by default; see docs/observability.md.
ASSISTANT_LANGFUSE_PUBLIC_KEY=
ASSISTANT_LANGFUSE_SECRET_KEY=
ASSISTANT_LANGFUSE_BASE_URL=https://cloud.langfuse.com
ASSISTANT_LANGFUSE_ENVIRONMENT=development
# Fraction of requests traced: 0..1.
ASSISTANT_LANGFUSE_SAMPLE_RATE=1.0
# true sends bounded private prompts/replies/tool data to Langfuse; false sends technical metadata only.
ASSISTANT_LANGFUSE_CAPTURE_CONTENT=false
